---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAdminSession } from '../../lib/admin-auth';
import { withBase } from '../../lib/base-path';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store, private');
const session = await getAdminSession(Astro.cookies);
if (!session) return Astro.redirect(withBase('/admin/login'));
---

<BaseLayout title="Order admin | Fruitfull Seeds EU" description="Fruitfull Seeds EU order administration.">
  <section class="admin-shell">
    <header class="admin-heading">
      <div><p class="eyebrow">Fruitfull EU</p><h1>Order desk</h1><p>Signed in as {session.email}</p></div>
      <button id="logout" class="secondary-button" type="button">Sign out</button>
    </header>

    <form id="filters" class="filters" role="search">
      <label class="search-field"><span>Search orders</span><input name="search" type="search" placeholder="Reference, name, or email" /></label>
      <label><span>Status</span><select name="status"><option value="">All statuses</option><option value="awaiting_payment">Awaiting payment</option><option value="paid">Paid</option><option value="awaiting_shipment">Awaiting shipment</option><option value="shipped">Shipped</option><option value="cancelled">Cancelled</option><option value="expired">Expired</option></select></label>
      <label><span>Sort</span><select name="sort"><option value="newest">Newest first</option><option value="oldest">Oldest first</option></select></label>
      <button class="primary-button" type="submit">Apply</button>
    </form>

    <div id="orders-status" class="status-line" role="status" aria-live="polite">Loading orders…</div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Reference</th><th>Customer</th><th>Status</th><th>Total</th><th>Created / expiry</th><th><span class="sr-only">View</span></th></tr></thead>
        <tbody id="orders-body"></tbody>
      </table>
    </div>
    <nav class="pagination" aria-label="Order results pages">
      <button id="previous-page" class="secondary-button" type="button">Previous</button><span id="page-label">Page 1</span><button id="next-page" class="secondary-button" type="button">Next</button>
    </nav>

    <section id="order-detail" class="detail-panel" hidden tabindex="-1" aria-labelledby="detail-reference">
      <header class="detail-heading">
        <div>
          <p class="eyebrow">Order detail</p>
          <div class="detail-title-line"><h2 id="detail-reference"></h2><span id="detail-status" class="status-pill"></span></div>
        </div>
        <button id="close-detail" class="icon-button" type="button" aria-label="Close order detail">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
        </button>
      </header>
      <div id="detail-alert" class="detail-alert" role="status" aria-live="polite"></div>
      <div class="detail-grid">
        <section class="info-card"><h3>Customer</h3><dl id="customer-details"></dl></section>
        <section class="info-card"><h3>Payment</h3><dl id="payment-details"></dl></section>
        <section class="info-card delivery-card"><h3>Delivery</h3><dl id="delivery-details"></dl></section>
        <section class="wide"><h3>Items</h3><div id="item-details" class="item-list"></div></section>
        <section class="wide"><h3>Customer notes</h3><p id="customer-notes" class="long-copy"></p></section>
      </div>
      <section class="actions-panel">
        <div class="section-heading"><div><h3>Order actions</h3><p>Update fulfillment details or move this order to its next state.</p></div></div>
        <div class="next-step-card"><div><span class="action-kicker">Next step</span><p id="transition-help"></p></div><div id="transition-actions" class="button-row"></div></div>
        <form data-action-form="update_tracking" class="action-form"><div class="action-form-heading"><div><h4>Tracking</h4><p>Add or update the delivery details shown with this order.</p></div></div><div class="form-grid"><label><span>Carrier</span><input name="trackingCarrier" autocomplete="off" /></label><label><span>Tracking number</span><input name="trackingNumber" autocomplete="off" /></label><label class="wide"><span>Tracking URL</span><input name="trackingUrl" type="url" inputmode="url" placeholder="https://" /></label></div><button class="secondary-button" type="submit">Save tracking</button></form>
        <form data-action-form="add_note" class="action-form"><div class="action-form-heading"><div><h4>Internal note</h4><p>Visible to administrators only.</p></div></div><label><span>Note</span><textarea name="note" rows="3" required></textarea></label><button class="secondary-button" type="submit">Add note</button></form>
        <div class="utility-actions">
          <div class="utility-action"><div><h4>Email notification</h4><p>Adds another notification for the order's current status to the queue. It will not send until email delivery is configured.</p></div><button class="secondary-button" data-action="retry_email" type="button">Queue email again</button></div>
          <div class="utility-action privacy-action"><div><h4>Personal data</h4><p>Permanently clears the customer's contact, payment-name, notes, and order-level address fields. Available only after an order is complete, cancelled, or expired.</p></div><button class="danger-button" data-action="anonymize" type="button">Anonymize personal data</button></div>
        </div>
        <form data-action-form="cancel" class="action-form cancel-form"><div class="action-form-heading"><div><h4>Cancel order</h4><p>Releases its reserved inventory and cannot be undone here.</p></div></div><label><span>Cancellation reason</span><textarea name="note" rows="2" required></textarea></label><button class="danger-button" type="submit">Cancel order</button></form>
      </section>
      <section class="history"><div><h3>Event history</h3><ol id="event-history"></ol></div><div><h3>Notifications</h3><ol id="notification-history"></ol></div></section>
    </section>
  </section>
</BaseLayout>

<script>
  import { withBase } from '../../lib/base-path';

  type Order = Record<string, any>;
  let orders: Order[] = [];
  let selected: Order | null = null;
  let page = 1;
  let total = 0;
  const pageSize = 25;
  const $ = <T extends Element>(selector: string) => document.querySelector<T>(selector);
  const money = (minor: number, currency: string) => new Intl.NumberFormat('en-GB', { style: 'currency', currency }).format((minor || 0) / 100);
  const dateTime = (value?: string) => value ? new Date(value).toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' }) : '—';
  const label = (value: string) => value?.replaceAll('_', ' ') || '—';
  const filters = $<HTMLFormElement>('#filters');
  const statusLine = $<HTMLElement>('#orders-status');
  const tbody = $<HTMLElement>('#orders-body');
  const detail = $<HTMLElement>('#order-detail');

  const appendDefinition = (list: HTMLElement, term: string, value: unknown) => {
    const wrap = document.createElement('div'), dt = document.createElement('dt'), dd = document.createElement('dd');
    dt.textContent = term; dd.textContent = value == null || value === '' ? '—' : String(value);
    if (term === 'Total') wrap.className = 'definition-total';
    wrap.append(dt, dd); list.append(wrap);
  };

  const loadOrders = async (focusId?: string) => {
    if (statusLine) statusLine.textContent = 'Loading orders…';
    const fields = new FormData(filters || undefined);
    const query = new URLSearchParams({ page: String(page), search: String(fields.get('search') || ''), status: String(fields.get('status') || ''), sort: String(fields.get('sort') || 'newest') });
    const response = await fetch(`${withBase('/api/admin/orders')}?${query}`).catch(() => null);
    if (response?.status === 401) { location.href = withBase('/admin/login'); return; }
    const result = await response?.json().catch(() => null);
    if (!response?.ok || !result) { if (statusLine) statusLine.textContent = 'Orders are temporarily unavailable.'; return; }
    orders = result.orders; total = result.total; renderTable();
    if (statusLine) statusLine.textContent = `${total} order${total === 1 ? '' : 's'} found`;
    const pages = Math.max(1, Math.ceil(total / pageSize));
    const pageLabel = $<HTMLElement>('#page-label'); if (pageLabel) pageLabel.textContent = `Page ${page} of ${pages}`;
    const previous = $<HTMLButtonElement>('#previous-page'), next = $<HTMLButtonElement>('#next-page'); if (previous) previous.disabled = page <= 1; if (next) next.disabled = page >= pages;
    if (focusId) { const order = orders.find((candidate) => candidate.id === focusId); if (order) renderDetail(order); }
  };

  const renderTable = () => {
    if (!tbody) return; tbody.replaceChildren();
    if (!orders.length) { const row = document.createElement('tr'), cell = document.createElement('td'); cell.colSpan = 6; cell.className = 'empty-row'; cell.textContent = 'No orders match these filters.'; row.append(cell); tbody.append(row); return; }
    orders.forEach((order) => {
      const row = document.createElement('tr');
      const reference = document.createElement('td'); reference.dataset.label = 'Reference'; const referenceText = document.createElement('strong'); referenceText.className = 'reference-value'; referenceText.textContent = order.reference; reference.append(referenceText); row.append(reference);
      const customer = document.createElement('td'); customer.dataset.label = 'Customer'; const customerName = document.createElement('strong'); customerName.textContent = order.customer_name || 'Anonymized'; customer.append(customerName); if (order.customer_email) { const email = document.createElement('small'); email.className = 'customer-email'; email.textContent = order.customer_email; customer.append(email); } row.append(customer);
      const status = document.createElement('td'); status.dataset.label = 'Status'; const statusPill = document.createElement('span'); statusPill.className = `status-pill status-${order.status}`; statusPill.textContent = label(order.status); status.append(statusPill); row.append(status);
      const totalCell = document.createElement('td'); totalCell.dataset.label = 'Total'; totalCell.className = 'money-value'; totalCell.textContent = money(order.total_minor, order.currency); row.append(totalCell);
      const dates = document.createElement('td'); dates.dataset.label = 'Created / expiry'; dates.className = 'date-cell'; const created = document.createElement('span'); created.className = 'date-line'; created.textContent = dateTime(order.created_at); dates.append(created);
      if (order.status === 'awaiting_payment') { const expiry = document.createElement('small'); const expired = new Date(order.expires_at) <= new Date(); expiry.className = expired ? 'expiry expired' : 'expiry'; expiry.textContent = `${expired ? 'Expired' : 'Expires'} ${dateTime(order.expires_at)}`; dates.append(expiry); }
      row.append(dates);
      const actionCell = document.createElement('td'), button = document.createElement('button'); actionCell.className = 'table-action'; actionCell.dataset.label = 'Action'; button.type = 'button'; button.className = 'table-button'; button.textContent = 'View details'; button.setAttribute('aria-label', `View order ${order.reference}`); button.addEventListener('click', () => renderDetail(order)); actionCell.append(button); row.append(actionCell); tbody.append(row);
    });
  };

  const renderDetail = (order: Order) => {
    selected = order; if (!detail) return; detail.hidden = false;
    const ref = $<HTMLElement>('#detail-reference'), state = $<HTMLElement>('#detail-status'); if (ref) ref.textContent = order.reference; if (state) { state.textContent = label(order.status); state.className = `status-pill status-${order.status}`; }
    const customer = $<HTMLElement>('#customer-details'); if (customer) { customer.replaceChildren(); appendDefinition(customer, 'Name', order.customer_name); appendDefinition(customer, 'Email', order.customer_email); appendDefinition(customer, 'Phone', order.customer_phone); }
    const payment = $<HTMLElement>('#payment-details'); if (payment) { payment.replaceChildren(); appendDefinition(payment, 'Method', order.payment_method); appendDefinition(payment, 'Account name', order.payment_name); appendDefinition(payment, 'Subtotal', money(order.subtotal_minor, order.currency)); appendDefinition(payment, 'Shipping', money(order.shipping_minor, order.currency)); appendDefinition(payment, 'Total', money(order.total_minor, order.currency)); appendDefinition(payment, 'Reserved until', dateTime(order.expires_at)); }
    const delivery = $<HTMLElement>('#delivery-details'); if (delivery) { delivery.replaceChildren(); const address = order.shipping_address; appendDefinition(delivery, 'Address', address ? [address.line1, address.line2, address.city, address.region, address.postalCode, address.countryCode].filter(Boolean).join(', ') : null); appendDefinition(delivery, 'Carrier', order.tracking_carrier); appendDefinition(delivery, 'Tracking no.', order.tracking_number); appendDefinition(delivery, 'Tracking URL', order.tracking_url); }
    const itemBox = $<HTMLElement>('#item-details'); if (itemBox) { itemBox.replaceChildren(); (order.order_items || []).forEach((item: Order) => { const row = document.createElement('div'); row.className = 'item-row'; const itemMain = document.createElement('div'), quantity = document.createElement('span'), copy = document.createElement('div'), name = document.createElement('strong'), sku = document.createElement('small'), amount = document.createElement('strong'); itemMain.className = 'item-main'; quantity.className = 'quantity-badge'; quantity.textContent = `${item.quantity}×`; name.textContent = item.name; sku.textContent = item.sku; amount.className = 'item-amount'; amount.textContent = money(item.line_total_minor, item.currency); copy.append(name, sku); itemMain.append(quantity, copy); row.append(itemMain, amount); itemBox.append(row); }); }
    const notes = $<HTMLElement>('#customer-notes'); if (notes) notes.textContent = order.customer_notes || 'No customer notes.';
    const trackingForm = $<HTMLFormElement>('[data-action-form="update_tracking"]'); if (trackingForm) { ['trackingCarrier','trackingNumber','trackingUrl'].forEach((name) => { const input = trackingForm.elements.namedItem(name) as HTMLInputElement; if (input) input.value = order[name.replace(/[A-Z]/g, (letter) => `_${letter.toLowerCase()}`)] || ''; }); }
    const transitions = $<HTMLElement>('#transition-actions'), transitionHelp = $<HTMLElement>('#transition-help');
    const nextActions: Record<string, [string,string,string]> = {
      awaiting_payment: ['mark_paid', 'Mark as paid', 'Payment is still outstanding. Confirm receipt to continue fulfillment.'],
      paid: ['mark_awaiting_shipment', 'Ready for shipment', 'Payment is confirmed. Move the order into the packing and shipping queue.'],
      awaiting_shipment: ['mark_shipped', 'Mark as shipped', 'The order is ready to leave. Add tracking first if it is available.'],
    };
    const nextAction = nextActions[order.status];
    if (transitionHelp) transitionHelp.textContent = nextAction?.[2] || (order.status === 'shipped' ? 'This order is complete. Tracking details can still be updated below.' : 'This order is in a terminal state and has no further fulfillment steps.');
    if (transitions) { transitions.replaceChildren(); if (nextAction) { const [action, text] = nextAction; const button = document.createElement('button'); button.type='button'; button.className='primary-button status-transition-button'; button.dataset.action=action; button.textContent=text; transitions.append(button); } }
    const cancelForm = $<HTMLFormElement>('[data-action-form="cancel"]'); if (cancelForm) cancelForm.hidden = ['shipped','cancelled','expired'].includes(order.status);
    const anon = $<HTMLButtonElement>('[data-action="anonymize"]'); if (anon) anon.disabled = !['shipped','cancelled','expired'].includes(order.status) || Boolean(order.anonymized_at);
    const retry = $<HTMLButtonElement>('[data-action="retry_email"]'); if (retry) retry.disabled = Boolean(order.anonymized_at);
    renderHistory(order); detail.focus();
  };

  const renderHistory = (order: Order) => {
    const events = $<HTMLOListElement>('#event-history'); if (events) { events.replaceChildren(); const rows = [...(order.order_events || [])].sort((a,b) => a.created_at.localeCompare(b.created_at)); if (!rows.length) { const empty = document.createElement('li'); empty.className = 'empty-history'; empty.textContent = 'No events recorded.'; events.append(empty); } rows.forEach((event: Order) => { const row = document.createElement('li'); row.textContent = `${dateTime(event.created_at)} — ${label(event.event_type)}${event.actor_email ? ` by ${event.actor_email}` : ''}${event.note ? `: ${event.note}` : ''}`; events.append(row); }); }
    const notifications = $<HTMLOListElement>('#notification-history'); if (notifications) { notifications.replaceChildren(); const rows = [...(order.notification_outbox || [])].sort((a,b) => b.created_at.localeCompare(a.created_at)); if (!rows.length) { const empty = document.createElement('li'); empty.className = 'empty-history'; empty.textContent = 'No notifications queued.'; notifications.append(empty); } rows.forEach((event: Order) => { const row = document.createElement('li'); row.textContent = `${dateTime(event.created_at)} — ${label(event.template_key)}: ${event.sent_at ? 'sent' : event.last_error ? `failed (${event.last_error})` : 'queued'}; attempts ${event.attempts}`; notifications.append(row); }); }
  };

  const mutate = async (action: string, payload: Record<string, unknown> = {}) => {
    if (!selected) return;
    if (action === 'anonymize' && !confirm('Permanently clear this customer’s contact, payment-name, notes, and order-level address fields? This cannot be undone.')) return;
    if (action === 'cancel' && !confirm('Cancel this order and release its inventory?')) return;
    const alert = $<HTMLElement>('#detail-alert'); if (alert) { alert.dataset.tone = 'pending'; alert.textContent = 'Saving…'; }
    const buttons = [...(detail?.querySelectorAll<HTMLButtonElement>('button') || [])]; const buttonStates = buttons.map((button) => [button, button.disabled] as const); buttons.forEach((button) => button.disabled = true);
    const response = await fetch(withBase(`/api/admin/orders/${selected.id}`), { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action, version: selected.version, payload }) }).catch(() => null);
    const result = await response?.json().catch(() => null);
    buttonStates.forEach(([button, wasDisabled]) => button.disabled = wasDisabled);
    if (!response?.ok) { if (alert) { alert.dataset.tone = 'error'; alert.textContent = response?.status === 409 ? 'Another administrator changed this order. It has been refreshed.' : `Could not update: ${label(result?.error || 'request failed')}.`; } if (response?.status === 409) await loadOrders(selected.id); return; }
    if (alert) { alert.dataset.tone = 'success'; alert.textContent = 'Order updated.'; } await loadOrders(selected.id);
  };

  filters?.addEventListener('submit', (event) => { event.preventDefault(); page = 1; loadOrders(); });
  $('#previous-page')?.addEventListener('click', () => { page = Math.max(1, page - 1); loadOrders(); }); $('#next-page')?.addEventListener('click', () => { page += 1; loadOrders(); });
  $('#close-detail')?.addEventListener('click', () => { if (detail) detail.hidden = true; selected = null; });
  detail?.addEventListener('click', (event) => { const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-action]'); if (!button?.dataset.action) return; if (button.dataset.action === 'mark_shipped') { const form = $<HTMLFormElement>('[data-action-form="update_tracking"]'); mutate(button.dataset.action, form ? Object.fromEntries(new FormData(form)) : {}); } else mutate(button.dataset.action); });
  detail?.querySelectorAll<HTMLFormElement>('[data-action-form]').forEach((form) => form.addEventListener('submit', (event) => { event.preventDefault(); if (!form.reportValidity()) return; const payload = Object.fromEntries(new FormData(form)); mutate(form.dataset.actionForm || '', payload); if (form.dataset.actionForm === 'add_note' || form.dataset.actionForm === 'cancel') form.reset(); }));
  $('#logout')?.addEventListener('click', async () => { await fetch(withBase('/api/admin/logout'), { method: 'POST' }); location.href = withBase('/admin/login'); });
  loadOrders();
</script>

<style is:global>
  .admin-shell { position:relative; left:50%; width:min(74rem,calc(100vw - 2rem)); padding-top:3rem; transform:translateX(-50%); }
  .eyebrow { color:var(--ff-grape-neon); font-size:.7rem; font-weight:900; letter-spacing:.16em; text-transform:uppercase; }
  .admin-heading,.detail-heading { display:flex; align-items:flex-start; justify-content:space-between; gap:1rem; }
  .admin-heading h1 { margin-top:.6rem; color:var(--ff-resin-cream); font-family:'Pokemon GB',monospace; font-size:clamp(1.5rem,4vw,2.2rem); line-height:1.5; }
  .admin-heading p:last-child { margin-top:.5rem; color:var(--ff-text-muted); font-size:.875rem; }

  .filters { display:grid; grid-template-columns:minmax(16rem,2fr) minmax(10rem,1fr) minmax(10rem,1fr) auto; align-items:end; gap:1rem; margin-top:2rem; padding:1.25rem; border:1px solid var(--ff-border-subtle); border-radius:1rem; background:var(--ff-bg-secondary); }
  .filters label span,.action-form label>span { display:block; margin-bottom:.45rem; color:var(--ff-text-secondary); font-size:.75rem; font-weight:800; }
  .filters input,.filters select,.action-form input,.action-form textarea { width:100%; min-height:46px; padding:.7rem .8rem; border:1px solid var(--ff-border-subtle); border-radius:.7rem; background:var(--ff-bg-primary); color:var(--ff-text-primary); font-size:.9rem; transition:border-color .2s ease,box-shadow .2s ease; }
  .filters input:focus,.filters select:focus,.action-form input:focus,.action-form textarea:focus { border-color:var(--ff-grape-neon); box-shadow:0 0 0 3px rgba(182,140,255,.15); }
  .action-form textarea { resize:vertical; line-height:1.55; }
  .primary-button,.secondary-button,.danger-button,.table-button,.icon-button { min-height:44px; border-radius:.7rem; padding:.7rem 1rem; font-size:.85rem; font-weight:800; cursor:pointer; transition:background-color .2s ease,border-color .2s ease,color .2s ease,box-shadow .2s ease; }
  .primary-button { border:1px solid transparent; background:var(--ff-grape-vivid); color:white; box-shadow:0 8px 24px rgba(122,92,255,.2); }
  .primary-button:hover:not(:disabled) { background:var(--ff-grape-neon); color:#0b0b10; box-shadow:0 10px 28px rgba(182,140,255,.28); }
  .secondary-button,.table-button,.icon-button { border:1px solid var(--ff-border-subtle); background:var(--ff-bg-tertiary); color:var(--ff-text-primary); }
  .secondary-button:hover:not(:disabled),.table-button:hover:not(:disabled),.icon-button:hover:not(:disabled) { border-color:var(--ff-grape-neon); background:#29283a; }
  .danger-button { border:1px solid #ff6b7a; background:rgba(255,73,94,.12); color:#ffabb3; }
  .danger-button:hover:not(:disabled) { background:rgba(255,73,94,.22); color:#ffd9dd; }
  button:disabled { opacity:.42; cursor:not-allowed; box-shadow:none; }
  .icon-button { display:grid; width:44px; padding:0; place-items:center; flex:0 0 auto; }
  .icon-button svg { width:20px; height:20px; fill:none; stroke:currentColor; stroke-width:2.25; stroke-linecap:round; }

  .status-line { min-height:1.5rem; margin:1.25rem 0 .75rem; color:var(--ff-text-secondary); font-size:.85rem; }
  .table-wrap { overflow:hidden; border:1px solid var(--ff-border-subtle); border-radius:1rem; background:var(--ff-bg-secondary); box-shadow:0 16px 40px rgba(0,0,0,.14); }
  table { width:100%; min-width:880px; border-collapse:separate; border-spacing:0; table-layout:fixed; }
  th,td { padding:1rem 1.15rem; border-bottom:1px solid var(--ff-border-subtle); text-align:left; vertical-align:middle; }
  th { color:var(--ff-text-muted); background:rgba(255,255,255,.012); font-size:.69rem; font-weight:900; text-transform:uppercase; letter-spacing:.1em; }
  th:nth-child(1) { width:18%; } th:nth-child(2) { width:22%; } th:nth-child(3) { width:17%; } th:nth-child(4) { width:11%; } th:nth-child(5) { width:21%; } th:nth-child(6) { width:11%; }
  td { color:var(--ff-text-primary); font-size:.875rem; line-height:1.35; }
  tbody tr { transition:background-color .18s ease; }
  tbody tr:hover { background:var(--ff-bg-tertiary); }
  tbody tr:last-child td { border-bottom:0; }
  .reference-value,.money-value,.date-cell { font-variant-numeric:tabular-nums; }
  .reference-value { color:var(--ff-resin-cream); font-size:.84rem; letter-spacing:.01em; overflow-wrap:anywhere; }
  td>strong { display:block; font-weight:800; }
  .customer-email { display:block; margin-top:.3rem; color:var(--ff-text-muted); font-size:.73rem; overflow-wrap:anywhere; }
  .money-value { color:var(--ff-resin-cream); font-weight:800; white-space:nowrap; }
  .date-line { display:block; white-space:nowrap; }
  .status-pill { display:inline-flex; min-height:28px; align-items:center; padding:.32rem .58rem; border:1px solid transparent; border-radius:999px; font-size:.68rem; font-weight:900; line-height:1.15; text-transform:uppercase; letter-spacing:.055em; }
  .status-awaiting_payment { border-color:rgba(255,204,77,.38); background:rgba(255,204,77,.11); color:#ffdb78; }
  .status-paid,.status-awaiting_shipment { border-color:rgba(61,243,255,.32); background:rgba(61,243,255,.1); color:#8ef8ff; }
  .status-shipped { border-color:rgba(125,255,63,.3); background:rgba(125,255,63,.1); color:#aaff80; }
  .status-cancelled,.status-expired { border-color:var(--ff-border-subtle); background:var(--ff-bg-tertiary); color:var(--ff-text-secondary); }
  .expiry { display:block; margin-top:.35rem; color:var(--ff-status-upcoming); font-size:.72rem; line-height:1.35; }
  .expiry.expired { color:#ffabb3; }
  .table-action { text-align:right; }
  .table-button { white-space:nowrap; }
  .empty-row { padding:2.5rem; color:var(--ff-text-muted); text-align:center; }
