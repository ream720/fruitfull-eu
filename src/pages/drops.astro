---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { EUROPE_SHIPPING_COUNTRIES } from '../lib/countries';
import { formatMoney, getDropStatus, statusLabel, type PublicDrop } from '../lib/drops';
import { getPublicDrops } from '../lib/supabase-rest';
import { withBase } from '../lib/base-path';

export const prerender = false;

let drops: PublicDrop[] = [];
let catalogUnavailable = false;
try { drops = await getPublicDrops(); } catch { catalogUnavailable = true; }

const previewState = Astro.url.searchParams.get('preview');
const previewMode = import.meta.env.DEV && (previewState === '1' || previewState === 'confirmation');
const confirmationPreviewMode = import.meta.env.DEV && previewState === 'confirmation';
if (previewMode) {
  const entries = await getCollection('drops');
  drops = entries.map(({ data }) => ({
    id: data.id, slug: data.slug, title: data.title, description: data.description,
    opens_at: data.opensAt, closes_at: data.closesAt || null,
    currency: data.currency, shipping_amount_minor: data.shippingAmountMinor,
    payment_methods: data.paymentMethods, active: true,
    drop_items: data.items.map((item) => ({
      id: item.id, drop_id: data.id, sku: item.sku, name: item.name,
      item_type: item.type, artist: item.artist, image_path: item.image,
      secondary_image_path: item.secondaryImage || null,
      description: item.description, amount_minor: item.amountMinor,
      stock_total: item.stockTotal, stock_available: item.stockTotal,
      max_per_order: item.maxPerOrder, active: true,
    })),
  }));
}

const turnstileSiteKey = process.env.PUBLIC_TURNSTILE_SITE_KEY || import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
const visibleDrops = drops.filter((drop) => drop.active);
---

<BaseLayout title="Drops | Fruitfull Seeds EU" description="Reserve limited Fruitfull Seeds EU artist drops.">
  <section class="drop-hero">
    <h1>Fruitfull Drops</h1>
    <p>Complete payment within 48 hours to hold your reservation.</p>
  </section>

  {catalogUnavailable && (
    <div class="notice" role="status">Drop availability is temporarily unavailable. Please check back shortly.</div>
  )}

  {visibleDrops.length === 0 ? (
    <section class="empty-state">
      <span aria-hidden="true" class="empty-icon">✦</span>
      <h2>The next drop is taking shape</h2>
      <p>There are no reservable items right now.</p>
      <a class="primary-link" href={withBase('/genetics')}>Browse EU genetics</a>
    </section>
  ) : (
    <div class="drop-list">
      {visibleDrops.map((drop) => {
        const status = getDropStatus(drop);
        const availableItems = drop.drop_items.filter((item) => item.active);
        const confirmationPreviewTotal = drop.shipping_amount_minor + (availableItems[0]?.amount_minor || 0);
        const confirmationPreviewExpiry = new Date(new Date(drop.opens_at).getTime() + 48 * 60 * 60 * 1000).toLocaleString('en-GB', { dateStyle: 'full', timeStyle: 'short' });
        return (
          <article class="drop-card" data-drop-id={drop.id} data-currency={drop.currency} data-shipping={drop.shipping_amount_minor}>
            <header class="drop-header">
              <div>
                <span class:list={['status-pill', `status-${status}`]}>{statusLabel[status]}</span>
                <h2>{drop.title}</h2>
                <p>{drop.description}</p>
              </div>
              <dl class="drop-meta">
                <div><dt>Opens</dt><dd>{new Date(drop.opens_at).toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' })}</dd></div>
                {drop.closes_at && <div><dt>Closes</dt><dd>{new Date(drop.closes_at).toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' })}</dd></div>}
                <div><dt>Shipping</dt><dd>{formatMoney(drop.shipping_amount_minor, drop.currency)}</dd></div>
              </dl>
            </header>

            <div class="item-grid">
              {availableItems.map((item) => (
                <section class:list={['item-card', item.stock_available < 1 && 'item-sold-out']} data-item-id={item.id} data-price={item.amount_minor} data-stock={item.stock_available} data-max={item.max_per_order}>
                  <div class:list={['item-art', item.secondary_image_path && 'item-art-pair']}>
                    <img src={withBase(item.image_path)} alt={`${item.name} primary pack artwork`} loading="lazy" />
                    {item.secondary_image_path && (
                      <img src={withBase(item.secondary_image_path)} alt={`${item.name} secondary pack artwork`} loading="lazy" />
                    )}
                  </div>
                  <div class="item-copy">
                    <p class="item-type">{item.item_type}</p>
                    <h3>{item.name}</h3>
                    <div class="item-bottom">
                      <div><strong>{formatMoney(item.amount_minor, drop.currency)}</strong><small>{item.stock_available > 0 ? `${item.stock_available} remaining` : 'Sold out'}</small></div>
                      {status === 'active' && item.stock_available > 0 && (
                        <div class="quantity" aria-label={`Quantity for ${item.name}`}>
                          <button type="button" data-quantity-change="-1" aria-label={`Decrease ${item.name} quantity`}>−</button>
                          <input aria-label={`${item.name} quantity`} inputmode="numeric" type="number" min="0" max={Math.min(item.max_per_order, item.stock_available)} value="0" data-quantity />
                          <button type="button" data-quantity-change="1" aria-label={`Increase ${item.name} quantity`}>+</button>
                        </div>
                      )}
                    </div>
                    {item.stock_available > 0 && <p class="limit">Maximum {item.max_per_order} per reservation</p>}
                  </div>
                </section>
              ))}
            </div>

            {status === 'active' && (
              <form class="reservation-form" novalidate hidden={confirmationPreviewMode}>
                <div class="form-heading">
                  <div><p class="eyebrow">Your reservation</p><h3>Delivery and payment details</h3></div>
                  <div class="order-total" aria-live="polite"><span>Total</span><strong data-total>{formatMoney(drop.shipping_amount_minor, drop.currency)}</strong><small>Includes {formatMoney(drop.shipping_amount_minor, drop.currency)} shipping</small></div>
                </div>
                <p class="basket-hint" data-basket-hint>Select at least one item above.</p>

                <fieldset><legend>Contact</legend><div class="form-grid">
                  <label class="wide"><span>Full name</span><input name="name" autocomplete="name" required maxlength="120" /></label>
                  <label><span>Email</span><input name="email" type="email" autocomplete="email" required maxlength="254" /></label>
                  <label><span>Phone <small>international format</small></span><input name="phone" type="tel" autocomplete="tel" placeholder="+44 20 1234 5678" required maxlength="32" /></label>
                </div></fieldset>

                <fieldset><legend>Payment</legend><div class="form-grid">
                  <div class="payment-method" aria-label="Payment method: PayPal"><span>Payment method</span><strong>PayPal request</strong><p>After reserving, we’ll send a payment request to your PayPal account.</p></div>
                  <input type="hidden" name="paymentMethod" value="PayPal" />
                  <label><span>PayPal email or username <small>(required)</small></span><input name="paymentName" inputmode="email" autocapitalize="none" spellcheck="false" aria-describedby={`paypal-help-${drop.id}`} required minlength="2" maxlength="120" /><small id={`paypal-help-${drop.id}`} class="field-help">Enter the exact email or @username connected to your PayPal account.</small></label>
                </div></fieldset>

                <fieldset><legend>Shipping</legend><div class="form-grid">
                  <label class="wide"><span>Address line 1</span><input name="line1" autocomplete="address-line1" required maxlength="160" /></label>
                  <label class="wide"><span>Address line 2 <small>optional</small></span><input name="line2" autocomplete="address-line2" maxlength="160" /></label>
                  <label><span>City or town</span><input name="city" autocomplete="address-level2" required maxlength="100" /></label>
                  <label><span>Region <small>optional</small></span><input name="region" autocomplete="address-level1" maxlength="100" /></label>
                  <label><span>Postcode</span><input name="postalCode" autocomplete="postal-code" required maxlength="24" /></label>
                  <label><span>Country</span><select name="countryCode" autocomplete="country" required><option value="">Choose a country</option>{EUROPE_SHIPPING_COUNTRIES.map(([code, name]) => <option value={code}>{name}</option>)}</select></label>
                </div></fieldset>

                <fieldset><legend>Anything else?</legend><label><span>Notes <small>optional</small></span><textarea name="notes" rows="4" maxlength="2000"></textarea></label></fieldset>
                <div class="agreements">
                  <label><input name="privacyAccepted" type="checkbox" required /><span>I acknowledge that my details will be used to process and deliver this reservation.</span></label>
                  <label><input name="reservationTermsAccepted" type="checkbox" required /><span>I understand payment must be completed before the 48-hour reservation expiry.</span></label>
                </div>
                <label class="honeypot" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off" /></label>
                {turnstileSiteKey && <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>}
                <button class="reserve-button" type="submit" disabled={previewMode || !turnstileSiteKey}>{previewMode ? 'Preview only' : turnstileSiteKey ? 'Reserve selected items' : 'Reservations unavailable'}</button>
                <p class="form-status" data-form-status aria-live="polite"></p>
              </form>
            )}
            {status !== 'active' && status !== 'upcoming' && <div class="inactive-message">{status === 'sold_out' ? 'Every item in this drop has been reserved.' : 'This reservation window has closed.'}</div>}
            <section
              class="reservation-success"
              hidden={!confirmationPreviewMode}
              data-success
              role="status"
              aria-live="polite"
              aria-labelledby={`reservation-success-title-${drop.id}`}
              tabindex="-1"
            >
              <div class="success-heading">
                <span class="success-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m5 12 4 4L19 6" />
                  </svg>
                </span>
                <div>
                  <p class="eyebrow">Order received</p>
                  <h3 id={`reservation-success-title-${drop.id}`}>Your packs are reserved</h3>
                  <p class="success-summary">Complete the PayPal request by the deadline below to keep your reservation active.</p>
                </div>
              </div>

              <div class="screenshot-reminder" role="note">
                <span class="reminder-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14.5 4 16 7h3a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h3l1.5-3h5Z" />
                    <circle cx="12" cy="13" r="3.25" />
                  </svg>
                </span>
                <div>
                  <strong>Take a screenshot before you leave this page</strong>
                  <p>No confirmation email will be sent. Keep a screenshot showing your reference, total, payment deadline, and payment instructions.</p>
                </div>
              </div>

              <dl class="confirmation-details">
                <div><dt>Reference</dt><dd class="confirmation-reference" data-success-reference>{confirmationPreviewMode ? 'FFEU-PREVIEW123' : ''}</dd></div>
                <div><dt>Total</dt><dd data-success-total>{confirmationPreviewMode ? formatMoney(confirmationPreviewTotal, drop.currency) : ''}</dd></div>
                <div><dt>Payment deadline</dt><dd data-success-expiry>{confirmationPreviewMode ? confirmationPreviewExpiry : ''}</dd></div>
              </dl>
              <div class="payment-instructions"><strong>Payment instructions</strong><p data-success-instructions>{confirmationPreviewMode ? 'We will send a PayPal payment request to the email or username supplied with the reservation.' : ''}</p></div>
              <p class="success-footer">Keep this screenshot until your order has arrived.</p>
            </section>
          </article>
        );
      })}
    </div>
  )}
</BaseLayout>

{turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<script>
  import { withBase } from '../lib/base-path';

  const money = (minor: number, currency: string) => new Intl.NumberFormat('en-GB', { style: 'currency', currency }).format(minor / 100);
  document.querySelectorAll<HTMLElement>('.drop-card').forEach((drop) => {
    const form = drop.querySelector<HTMLFormElement>('.reservation-form');
    if (!form) return;
    const currency = drop.dataset.currency || 'EUR';
    const shipping = Number(drop.dataset.shipping || 0);
    const items = Array.from(drop.querySelectorAll<HTMLElement>('[data-item-id]'));
    const selectedItems = () => items.map((item) => ({
      itemId: item.dataset.itemId || '', quantity: Number(item.querySelector<HTMLInputElement>('[data-quantity]')?.value || 0),
      price: Number(item.dataset.price || 0),
    })).filter((item) => item.quantity > 0);
    const idempotencyKey = crypto.randomUUID();
    const updateTotal = () => {
      const selected = selectedItems();
      const subtotal = selected.reduce((sum, item) => sum + item.price * item.quantity, 0);
      const total = form.querySelector<HTMLElement>('[data-total]');
      const hint = form.querySelector<HTMLElement>('[data-basket-hint]');
      if (total) total.textContent = money(subtotal + shipping, currency);
      if (hint) hint.textContent = selected.length ? `${selected.reduce((sum, item) => sum + item.quantity, 0)} item(s) selected.` : 'Select at least one item above.';
    };
    items.forEach((item) => {
      const input = item.querySelector<HTMLInputElement>('[data-quantity]');
      item.querySelectorAll<HTMLButtonElement>('[data-quantity-change]').forEach((button) => button.addEventListener('click', () => {
        if (!input) return;
        const next = Number(input.value || 0) + Number(button.dataset.quantityChange || 0);
        input.value = String(Math.max(0, Math.min(Number(input.max), next)));
        updateTotal();
      }));
      input?.addEventListener('change', () => {
        input.value = String(Math.max(0, Math.min(Number(input.max), Number(input.value || 0)))); updateTotal();
      });
    });
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const status = form.querySelector<HTMLElement>('[data-form-status]');
      const firstInvalid = form.querySelector<HTMLElement>(':invalid');
      if (firstInvalid) { firstInvalid.focus(); form.reportValidity(); return; }
      const chosen = selectedItems().map(({ itemId, quantity }) => ({ itemId, quantity }));
      if (!chosen.length) { if (status) status.textContent = 'Choose at least one item.'; items[0]?.scrollIntoView({ behavior: 'smooth' }); return; }
      const fields = new FormData(form);
      const turnstileToken = String(fields.get('cf-turnstile-response') || '');
      if (!turnstileToken) { if (status) status.textContent = 'Complete the security check.'; return; }
      const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (submit) submit.disabled = true;
      if (status) status.textContent = 'Holding your items…';
      const payload = {
        dropId: drop.dataset.dropId, items: chosen,
        customer: { name: fields.get('name'), email: fields.get('email'), phone: fields.get('phone'), paymentMethod: fields.get('paymentMethod'), paymentName: fields.get('paymentName'), notes: fields.get('notes') },
        shipping: { line1: fields.get('line1'), line2: fields.get('line2'), city: fields.get('city'), region: fields.get('region'), postalCode: fields.get('postalCode'), countryCode: fields.get('countryCode') },
        privacyAccepted: fields.get('privacyAccepted') === 'on', reservationTermsAccepted: fields.get('reservationTermsAccepted') === 'on',
        turnstileToken, idempotencyKey, website: fields.get('website'),
      };
      const response = await fetch(withBase('/api/reservations'), { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) }).catch(() => null);
      const result = await response?.json().catch(() => ({}));
      if (response?.ok) {
        form.hidden = true;
        const success = drop.querySelector<HTMLElement>('[data-success]');
        if (success) success.hidden = false;
        const set = (selector: string, value: string) => { const node = drop.querySelector<HTMLElement>(selector); if (node) node.textContent = value; };
        set('[data-success-reference]', result.reference || ''); set('[data-success-total]', money(result.totalMinor, result.currency));
        set('[data-success-expiry]', new Date(result.expiresAt).toLocaleString('en-GB', { dateStyle: 'full', timeStyle: 'short' }));
        set('[data-success-instructions]', result.paymentInstructions || 'The team will send the PayPal request using the account details you provided.');
        success?.focus({ preventScroll: true });
        success?.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
      } else {
        const messages: Record<string, string> = { availability_changed: 'Availability changed while you were reserving. Refresh the page and choose again.', active_reservation_exists: 'This email or phone already has a live reservation for this drop.', security_check_failed: 'The security check expired. Please complete it again.', validation_failed: 'Check the form and try again.' };
        if (status) status.textContent = messages[result?.error] || 'Reservations are temporarily unavailable. Please try again.';
        const firstField = result?.fields ? Object.keys(result.fields)[0] : '';
        const target = firstField && firstField !== 'items' ? form.elements.namedItem(firstField) as HTMLElement | null : null;
        if (target) target.focus();
        if (submit) submit.disabled = false;
        (window as any).turnstile?.reset();
      }
    });
    updateTotal();
  });
</script>

<style>
  .drop-hero { padding: 4rem 0 3rem; max-width: 44rem; }
  .eyebrow, .item-type { color: var(--ff-grape-neon); font-size: .72rem; font-weight: 900; letter-spacing: .16em; text-transform: uppercase; }
  .drop-hero h1 { color: var(--ff-resin-cream); font-family: 'Pokemon GB', monospace; font-size: clamp(1.7rem, 5vw, 2.8rem); line-height: 1.45; }
  .drop-hero > p:last-child, .drop-hero > h1 + p { margin-top: 1rem; color: var(--ff-text-secondary); line-height: 1.8; }
  .notice { margin-top: 1.5rem; padding: .85rem 1rem; border: 1px solid var(--ff-resin-gold); border-radius: .75rem; color: var(--ff-resin-cream); background: rgba(214,184,90,.08); font-size: .85rem; }
  .empty-state { min-height: 24rem; display: grid; place-items: center; align-content: center; gap: 1rem; text-align: center; border: 1px dashed var(--ff-border-subtle); border-radius: 1.5rem; padding: 3rem 1.5rem; background: radial-gradient(circle at top, rgba(122,92,255,.15), transparent 55%); }
  .empty-state h2, .drop-header h2 { color: var(--ff-resin-cream); font-family: 'Pokemon GB', monospace; line-height: 1.6; }
  .empty-state p { max-width: 33rem; color: var(--ff-text-secondary); line-height: 1.7; }
  .empty-icon { font-size: 2.5rem; color: var(--ff-lime-bright); }
  .primary-link, .reserve-button { min-height: 48px; display: inline-flex; align-items: center; justify-content: center; border-radius: .75rem; background: var(--ff-grape-vivid); color: white; padding: .75rem 1.2rem; font-weight: 900; }
  .drop-list { display: grid; gap: 2rem; }
  .drop-card { overflow: hidden; border: 1px solid var(--ff-border-subtle); border-radius: 1.5rem; background: var(--ff-bg-secondary); }
  .drop-header { display: grid; gap: 1.5rem; padding: clamp(1.25rem,4vw,2rem); border-bottom: 1px solid var(--ff-border-subtle); }
  .drop-header h2 { margin-top: 1rem; font-size: clamp(1.1rem,4vw,1.55rem); }
  .drop-header p { margin-top: .75rem; max-width: 38rem; color: var(--ff-text-secondary); line-height: 1.7; }
  .status-pill { display: inline-flex; padding: .4rem .65rem; border-radius: 999px; font-size: .7rem; font-weight: 900; text-transform: uppercase; letter-spacing: .08em; }
  .status-active { color: #0b0b10; background: var(--ff-lime-bright); }.status-upcoming { color: #0b0b10; background: var(--ff-status-upcoming); }.status-sold_out,.status-closed { background: var(--ff-bg-tertiary); color: var(--ff-text-secondary); }
  .drop-meta { display: flex; flex-wrap: wrap; gap: 1rem 2rem; }.drop-meta dt { color: var(--ff-text-muted); font-size: .68rem; text-transform: uppercase; letter-spacing: .1em; }.drop-meta dd { margin-top: .3rem; font-size: .85rem; font-weight: 700; }
  .item-grid { display: grid; gap: 1px; background: var(--ff-border-subtle); }
  .item-card { display: grid; grid-template-columns: minmax(110px, 190px) 1fr; gap: 1.25rem; background: var(--ff-bg-secondary); padding: 1.25rem; }
  .item-art { aspect-ratio: 1; overflow: hidden; border-radius: 1rem; background: var(--ff-bg-primary); }.item-art img { width: 100%; height: 100%; object-fit: contain; }.item-art-pair { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: .5rem; padding: .5rem; }.item-sold-out .item-art { filter: grayscale(1); opacity: .55; }
  .item-copy h3 { margin-top: .35rem; color: var(--ff-resin-cream); font-size: 1.15rem; font-weight: 900; }
  .item-bottom { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin-top: 1.2rem; }.item-bottom strong,.item-bottom small { display: block; }.item-bottom small,.limit { color: var(--ff-text-muted); font-size: .7rem; margin-top: .25rem; }
  .quantity { display: flex; flex: 0 0 auto; align-items: center; border: 1px solid var(--ff-border-subtle); border-radius: .75rem; overflow: hidden; }.quantity button { width: 44px; height: 44px; flex: 0 0 44px; font-size: 1.25rem; background: var(--ff-bg-tertiary); }.quantity input[type='number'] { box-sizing: border-box; width: 52px; min-width: 52px; height: 44px; min-height: 44px; flex: 0 0 52px; border: 0; border-inline: 1px solid var(--ff-border-subtle); border-radius: 0; padding: 0 .25rem; background: var(--ff-bg-primary); color: white; font-size: 1rem; font-weight: 800; line-height: 44px; text-align: center; appearance: textfield; -moz-appearance: textfield; }.quantity input[type='number']::-webkit-inner-spin-button,.quantity input[type='number']::-webkit-outer-spin-button { margin: 0; appearance: none; }
  .reservation-form { border-top: 1px solid var(--ff-border-subtle); padding: clamp(1.25rem,4vw,2rem); }.form-heading { display: flex; align-items: start; justify-content: space-between; gap: 1rem; }.form-heading h3 { margin-top: .5rem; font-size: 1.15rem; font-weight: 900; }.order-total { min-width: 9rem; text-align: right; }.order-total span,.order-total small { display: block; color: var(--ff-text-muted); font-size: .7rem; }.order-total strong { display: block; color: var(--ff-lime-bright); font-size: 1.25rem; }.basket-hint { margin-top: 1rem; color: var(--ff-text-secondary); font-size: .85rem; }
  fieldset { margin-top: 2rem; padding: 0; border: 0; } legend { margin-bottom: 1rem; color: var(--ff-resin-cream); font-size: .8rem; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; }.form-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 1rem; }.wide { grid-column: 1/-1; } label > span { display: block; margin-bottom: .45rem; font-size: .8rem; font-weight: 800; } label small { color: var(--ff-text-muted); font-weight: 500; }
