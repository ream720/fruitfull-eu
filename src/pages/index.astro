---
import { Image } from 'astro:assets';
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/base-path";
---

<BaseLayout
  title="Fruitfull Seeds EU - Premium Genetics"
  description="Fruitfull Seeds for Europe. Follow future seed drops, events, and hashmaker-focused releases."
>
  <!-- Hero Section -->
  <div class="relative min-h-[45vh] flex items-center justify-center px-4 py-8 pb-12 overflow-hidden">
    <!-- Subtle Background Effects -->
    <div class="absolute inset-0 opacity-30 rounded-3xl overflow-hidden">
      <div class="absolute top-20 left-1/4 w-96 h-96 bg-ff-grape-vivid rounded-full mix-blend-multiply filter blur-3xl"></div>
      <div class="absolute bottom-20 right-1/4 w-96 h-96 bg-ff-peach-soft rounded-full mix-blend-multiply filter blur-3xl"></div>
    </div>

    <!-- Background Logo -->
    <div class="absolute inset-0 flex items-center justify-center pointer-events-none select-none z-0 overflow-hidden">
      <Image
        src={withBase('/images/fruitfull/logo/Characters.png')}
        alt=""
        width={1280}
        height={1280}
        class="w-[120%] max-w-5xl opacity-[0.08] object-contain scale-125"
        loading="eager"
      />
    </div>

    <!-- Content Container -->
    <div class="relative z-10 text-center max-w-5xl mx-auto space-y-4 md:space-y-6">


      <!-- Main Heading -->
      <div class="space-y-4 md:space-y-6">
        <h1 class="font-extrabold leading-tight space-y-2">
          <Image
            src={withBase('/images/fruitfull/logo/Logo1.png')}
            alt="Fruitfull Seeds"
            width={400}
            height={120}
            class="mx-auto w-full max-w-xs drop-shadow-lg filter"
            loading="eager"
          />
        </h1>

        <div class="flex items-center justify-center gap-4">
          <div class="h-px w-12 bg-ff-border-subtle"></div>
          <p class="text-sm md:text-base tracking-[0.2em] uppercase text-ff-text-secondary font-medium">
            Premium Genetics for Hashmakers
          </p>
          <div class="h-px w-12 bg-ff-border-subtle"></div>
        </div>
      </div>

      <!-- CTA Button -->
      <div class="pt-2">
        <a
          href={withBase('/genetics')}
          id="explore-cta"
          class="group relative inline-flex items-center gap-2 bg-ff-grape-vivid hover:bg-ff-grape-neon text-ff-text-primary font-bold px-8 sm:px-10 py-3 sm:py-4 rounded-ff-lg transition-all duration-300 shadow-lg hover:shadow-xl hover:scale-105 text-base sm:text-lg"
        >
          View EU Seed Library
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
          </svg>

          <!-- Cute Sprite Charm -->
          <Image
            id="cta-sprite"
            src={withBase('/images/fruitfull/sprites/sprite_berry_mist.png')}
            alt=""
            width={100}
            height={100}
            class="absolute -top-12 -right-6 w-24 h-24 object-contain filter drop-shadow-md transition-all duration-300 group-hover:scale-110 group-hover:-rotate-12 pointer-events-none"
            loading="lazy"
          />
        </a>
      </div>
    </div>
  </div>

  <script>
    import { withBase } from '../lib/base-path';

    const sprites = [
      withBase("/images/fruitfull/sprites/sprite_berry_mist.png"),
      withBase("/images/fruitfull/sprites/sprite_jelly_raunchers.png"),
      withBase("/images/fruitfull/sprites/sprite_missing_bow.png"),
      withBase("/images/fruitfull/sprites/sprite_ms_frizzle.png"),
      withBase("/images/fruitfull/sprites/sprite_oops_all_berries.png"),
      withBase("/images/fruitfull/sprites/sprite_peach_frozeti.png"),
      withBase("/images/fruitfull/sprites/sprite_pinkalicious.PNG"),
      withBase("/images/fruitfull/sprites/sprite_rainbow_juice.png"),
      withBase("/images/fruitfull/sprites/sprite_rg5_s1.png"),
      withBase("/images/fruitfull/sprites/sprite_watermelon_welchz.png"),
      withBase("/images/fruitfull/sprites/sprite_purple_peelz.png"),
      withBase("/images/fruitfull/sprites/sprite_galapagos.png")
    ];

    const btn = document.getElementById('explore-cta');
    const spriteImg = document.getElementById('cta-sprite') as HTMLImageElement;

    if (btn && spriteImg) {
      // Preload images to prevent flickering
      sprites.forEach(src => {
        const img = new Image();
        img.src = src;
      });

      btn.addEventListener('mouseenter', () => {
        // Pick a random sprite different from the current one if possible,
        // or just random. Random is fine.
        const randomSprite = sprites[Math.floor(Math.random() * sprites.length)];
        spriteImg.src = randomSprite;
      });
    }


  </script>
</BaseLayout>
