---
---

<section id="newsletter" class="relative z-10 px-4 py-8 md:py-12">
  <div class="max-w-xl mx-auto text-center">
    <!-- Section Header -->
    <div class="space-y-3 mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-ff-grape-vivid/10 border border-ff-grape-vivid/20">
        <svg class="w-4 h-4 text-ff-grape-neon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
        </svg>
        <span class="text-xs font-bold uppercase tracking-wider text-ff-grape-neon">Stay Updated</span>
      </div>
      <h2 class="text-2xl md:text-3xl font-bold text-ff-text-primary">
        Get Drop Alerts
      </h2>
      <p class="text-ff-text-secondary text-sm md:text-base max-w-md mx-auto">
        Be the first to know when new genetics drop in Europe. Confirm your address by email to join the list.
      </p>
    </div>

    <!-- Signup Form -->
    <form id="newsletter-form" class="space-y-4">
      <div class="flex flex-col sm:flex-row gap-3">
        <div class="relative flex-1">
          <input
            type="email"
            id="newsletter-email"
            name="email"
            placeholder="your@email.com"
            required
            autocomplete="email"
            class="w-full px-4 py-3 rounded-ff-lg bg-ff-bg-secondary border border-ff-border-subtle text-ff-text-primary placeholder:text-ff-text-muted/50 focus:outline-none focus:border-ff-grape-vivid focus:ring-1 focus:ring-ff-grape-vivid/30 transition-all duration-300 text-sm md:text-base"
          />
        </div>
        <button
          type="submit"
          id="newsletter-submit"
          class="group relative inline-flex items-center justify-center gap-2 bg-ff-grape-vivid hover:bg-ff-grape-neon text-ff-text-primary font-bold px-6 py-3 rounded-ff-lg transition-all duration-300 shadow-lg hover:shadow-xl hover:scale-[1.02] text-sm md:text-base whitespace-nowrap cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:scale-100"
        >
          <!-- Default state -->
          <span id="btn-text">Subscribe</span>

          <!-- Loading spinner (hidden by default) -->
          <svg id="btn-spinner" class="hidden w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>

          <!-- Arrow icon -->
          <svg id="btn-arrow" class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
          </svg>
        </button>
      </div>

      <label class="flex items-start gap-3 text-left text-xs text-ff-text-secondary max-w-lg mx-auto cursor-pointer">
        <input
          type="checkbox"
          id="newsletter-consent"
          name="consent"
          required
          class="mt-0.5 h-4 w-4 shrink-0 accent-ff-grape-vivid"
        />
        <span>I agree to receive Fruitfull Seeds EU email updates. I can unsubscribe at any time.</span>
      </label>

      <!-- Feedback Messages -->
      <div id="newsletter-feedback" class="hidden">
        <div id="feedback-success" class="hidden flex items-center justify-center gap-2 text-sm font-medium" style="color: #4ade80;">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span id="success-text">You're on the list!</span>
          <img src="/images/fruitfull/discord_react.webp" alt="" class="inline-block w-4 h-4 ml-1" />
        </div>
        <div id="feedback-error" class="hidden flex items-center justify-center gap-2 text-sm font-medium" style="color: #f87171;">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span id="error-text">Something went wrong.</span>
        </div>
      </div>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById('newsletter-form') as HTMLFormElement;
  const emailInput = document.getElementById('newsletter-email') as HTMLInputElement;
  const consentInput = document.getElementById('newsletter-consent') as HTMLInputElement;
  const submitBtn = document.getElementById('newsletter-submit') as HTMLButtonElement;
  const btnText = document.getElementById('btn-text')!;
  const btnSpinner = document.getElementById('btn-spinner')!;
  const btnArrow = document.getElementById('btn-arrow')!;
  const feedbackWrap = document.getElementById('newsletter-feedback')!;
  const feedbackSuccess = document.getElementById('feedback-success')!;
  const feedbackError = document.getElementById('feedback-error')!;
  const successText = document.getElementById('success-text')!;
  const errorText = document.getElementById('error-text')!;

  function setLoading(loading: boolean) {
    submitBtn.disabled = loading;
    btnText.textContent = loading ? 'Subscribing…' : 'Subscribe';
    btnSpinner.classList.toggle('hidden', !loading);
    btnArrow.classList.toggle('hidden', loading);
  }

  function showFeedback(type: 'success' | 'error', message: string) {
    feedbackWrap.classList.remove('hidden');
    feedbackSuccess.classList.toggle('hidden', type !== 'success');
    feedbackError.classList.toggle('hidden', type !== 'error');

    if (type === 'success') {
      successText.textContent = message;
    } else {
      errorText.textContent = message;
    }
  }

  function hideFeedback() {
    feedbackWrap.classList.add('hidden');
    feedbackSuccess.classList.add('hidden');
    feedbackError.classList.add('hidden');
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideFeedback();

    const email = emailInput.value.trim();
    if (!email) return;

    setLoading(true);

    try {
      const res = await fetch('/api/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, consent: consentInput.checked }),
      });

      const data = await res.json();

      if (data.success) {
        showFeedback('success', 'Check your inbox to confirm your subscription.');
        emailInput.value = '';
        consentInput.checked = false;
      } else {
        showFeedback('error', data.error || 'Something went wrong. Please try again.');
      }
    } catch {
      showFeedback('error', 'Network error. Please check your connection and try again.');
    } finally {
      setLoading(false);
    }
  });
</script>

<style>
  #newsletter-form input:focus {
    box-shadow: 0 0 0 3px rgba(122, 92, 255, 0.15);
  }

  #newsletter-feedback {
    animation: fade-slide-up 0.3s ease-out;
  }

  @keyframes fade-slide-up {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
