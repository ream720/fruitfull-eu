# Public site URL used for canonical URLs, sitemap, and robots.txt.
SITE_URL=https://fruitfullseeds.eu.com

# Use a dedicated EU list and a Brevo double-opt-in email template.
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_DOI_TEMPLATE_ID=
BREVO_DOI_REDIRECT_URL=https://fruitfullseeds.eu.com/?newsletter=confirmed#newsletter

# Supabase: connect a Frankfurt project through the Vercel Marketplace.
SUPABASE_URL=
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Invited Supabase Auth users allowed into /admin/orders (comma-separated).
ADMIN_EMAILS=

# Cloudflare Turnstile. Use official test keys for local automated testing.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Brevo order lifecycle transactional templates.
BREVO_ORDER_RESERVATION_TEMPLATE_ID=
BREVO_ORDER_PAID_TEMPLATE_ID=
BREVO_ORDER_AWAITING_SHIPMENT_TEMPLATE_ID=
BREVO_ORDER_SHIPPED_TEMPLATE_ID=
BREVO_ORDER_CANCELLED_TEMPLATE_ID=
BREVO_ORDER_EXPIRED_TEMPLATE_ID=

# Supabase Edge Function only; also add the same value to Vault as
# fruitfull_dispatch_secret for the scheduled invocation.
DISPATCH_SECRET=
