# Public site origin used for canonical URLs and sitemap generation.
SITE_URL=https://fruitfullseeds.com

# Use a dedicated EU list. Brevo is collection-only for the initial launch.
BREVO_API_KEY=
BREVO_LIST_ID=

# Supabase: connect a Frankfurt project through the Vercel Marketplace.
SUPABASE_URL=
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Invited Supabase Auth users allowed into /admin/orders (comma-separated).
ADMIN_EMAILS=

# Cloudflare Turnstile. Use official test keys for local automated testing.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
